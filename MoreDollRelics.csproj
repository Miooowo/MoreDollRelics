<Project Sdk="Godot.NET.Sdk/4.5.1">

	<PropertyGroup>

		<TargetFramework>net9.0</TargetFramework>

		<ImplicitUsings>true</ImplicitUsings>

		<LangVersion>12.0</LangVersion>

		<Nullable>enable</Nullable>

		<AssemblyName>MoreDollRelics</AssemblyName>

		<RootNamespace>MoreDollRelics</RootNamespace>

		<GodotPath>F:/megadot/MegaDot_v4.5.1-stable_mono_win64.exe</GodotPath>

		<!-- 改成你的杀戮尖塔2安装目录 -->

		<Sts2Dir>F:\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>

		<Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>

	</PropertyGroup>



	<ItemGroup>

		<Compile Remove="obj\**\*.cs" />

		<Compile Remove="bin\**\*.cs" />

		<Compile Remove=".godot\mono\temp\obj\**\*.cs" />

		<Compile Remove=".godot\mono\temp\bin\**\*.cs" />

	</ItemGroup>



	<ItemGroup>

		<Reference Include="sts2">

			<HintPath>$(Sts2DataDir)\sts2.dll</HintPath>

			<Private>false</Private>

		</Reference>

		<Reference Include="0Harmony">

			<HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>

			<Private>false</Private>

		</Reference>

		<Reference Include="Steamworks.NET">

			<HintPath>$(Sts2DataDir)\Steamworks.NET.dll</HintPath>

			<Private>false</Private>

		</Reference>

		<Reference Include="GodotSharp">

			<HintPath>$(Sts2DataDir)\GodotSharp.dll</HintPath>

			<Private>false</Private>

		</Reference>

	</ItemGroup>



	<Target Name="CopyMod" AfterTargets="Build">

		<Message Text="Copying MoreDollRelics mod..." Importance="high" />

		<MakeDir Directories="$(Sts2Dir)\mods\$(MSBuildProjectName)" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />

		<Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
		
		<Message Text="Exporting Godot .pck (preset ModPck) to mods folder..." Importance="high" Condition="Exists('$(GodotPath)')" />
		<Exec
			Command="&quot;$(GodotPath)&quot; --path &quot;$(MSBuildProjectDirectory)&quot; --headless --export-pack &quot;ModPck&quot; &quot;$(Sts2Dir)\mods\$(MSBuildProjectName)\$(MSBuildProjectName).pck&quot;"
			EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
			Condition="Exists('$(GodotPath)')"
			WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<Target Name="PackPreRelease" AfterTargets="CopyMod" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<PreReleaseDir>$(MSBuildProjectDirectory)\pre-release</PreReleaseDir>
			<PckOutputPath>$(Sts2Dir)\mods\$(MSBuildProjectName)\$(MSBuildProjectName).pck</PckOutputPath>
		</PropertyGroup>

		<Message Text="Packing pre-release artifacts..." Importance="high" />
		<MakeDir Directories="$(PreReleaseDir)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PreReleaseDir)\$(MSBuildProjectName).dll" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\$(MSBuildProjectName).json" DestinationFiles="$(PreReleaseDir)\$(MSBuildProjectName).json" />
		<Error Condition="!Exists('$(PckOutputPath)')" Text="Expected PCK not found at $(PckOutputPath). Please fix Godot export before releasing." />
		<Copy SourceFiles="$(PckOutputPath)" DestinationFiles="$(PreReleaseDir)\$(MSBuildProjectName).pck" />
		<Exec
			Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$manifest = Get-Content '$(MSBuildProjectDirectory)\$(MSBuildProjectName).json' -Encoding UTF8 -Raw | ConvertFrom-Json; $version = $manifest.version; $zipPath = '$(PreReleaseDir)\$(MSBuildProjectName)-' + $version + '.zip'; if (Test-Path $zipPath) { Remove-Item $zipPath -Force }; Compress-Archive -Path '$(PreReleaseDir)\$(MSBuildProjectName).dll','$(PreReleaseDir)\$(MSBuildProjectName).json','$(PreReleaseDir)\$(MSBuildProjectName).pck' -DestinationPath $zipPath -Force&quot;"
			WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

</Project>

